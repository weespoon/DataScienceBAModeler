{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "permissions": {
    "deny": [
      "Bash(chmod:*)",
      "Bash(chflags:*)",
      "Bash(*--score-holdout*)",
      "Bash(*score_holdout*)",
      "Bash(*titanic_agent.ensemble*)",
      "Bash(*holdout.csv*)",
      "Bash(make ensemble:*)",
      "Bash(make freeze:*)",
      "Read(./data/frozen/holdout.csv)",
      "Read(./data/raw/**)",
      "Edit(./data/frozen/**)",
      "Write(./data/frozen/**)",
      "Edit(./experiments/results.csv)",
      "Write(./experiments/results.csv)",
      "Edit(./experiments/findings.jsonl)",
      "Write(./experiments/findings.jsonl)",
      "Edit(./experiments/run_log.jsonl)",
      "Write(./experiments/run_log.jsonl)",
      "Edit(./experiments/champion.jsonl)",
      "Write(./experiments/champion.jsonl)",
      "Edit(./experiments/holdout_reads.json)",
      "Write(./experiments/holdout_reads.json)",
      "Edit(./experiments/val_reads.jsonl)",
      "Write(./experiments/val_reads.jsonl)"
    ],
    "allow": [
      "Bash(make status:*)",
      "Bash(make next:*)",
      "Bash(make verify:*)",
      "Bash(make receipts:*)",
      "Bash(make audit:*)",
      "Bash(make leakage:*)",
      "Bash(make log:*)",
      "Bash(make journal:*)",
      "Bash(make note:*)",
      "Bash(make finding:*)",
      "Bash(make findings:*)",
      "Bash(make backlog:*)",
      "Bash(make introspect:*)",
      "Bash(make runs:*)",
      "Bash(make summary:*)",
      "Bash(make report:*)",
      "Bash(make help:*)",
      "Bash(make experiments:*)",
      "Bash(make experiment-open:*)",
      "Bash(make experiment-lock-plan:*)",
      "Bash(make experiment-evaluate:*)",
      "Bash(make experiment-close:*)",
      "Bash(make champion:*)",
      "Bash(make permutation:*)",
      "Bash(make tune:*)",
      "Bash(make features:*)",
      "Bash(make nested:*)",
      "Bash(make bakeoff:*)",
      "Bash(make bakeoff-decide:*)",
      "Bash(make submit:*)",
      "Bash(make test:*)",
      "Bash(make lint:*)",
      "Bash(make setup:*)",
      "Bash(git status:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(git show:*)",
      "Bash(git ls-files:*)",
      "Bash(git rev-parse:*)",
      "Bash(git check-ignore:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(tail:*)",
      "Bash(wc:*)",
      "Bash(sed -n:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)",
      "Bash(shasum:*)",
      "Bash(date:*)",
      "Bash(echo:*)",
      "Bash(pwd)",
      "Bash(.venv/bin/pytest:*)",
      "Bash(.venv/bin/ruff:*)",
      "Read(./**)",
      "Edit(./experiments/**/plan.md)",
      "Write(./experiments/**/plan.md)",
      "Edit(./experiments/**/result.md)",
      "Write(./experiments/**/result.md)",
      "Edit(./runs/**)",
      "Write(./runs/**)",
      "Edit(./reports/**)",
      "Write(./reports/**)",
      "Edit(./docs/**)",
      "Write(./docs/**)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/protect_frozen.py\"",
            "timeout": 10,
            "statusMessage": "Checking Rule 1 (data/frozen immutability)"
          }
        ]
      }
    ]
  }
}
