# ---- Secrets & credentials (never commit) ----
.env
.env.*
!.env.example
kaggle.json
**/kaggle.json
.kaggle/

# ---- Data (never commit; see CLAUDE.md) ----
data/raw/*
!data/raw/.gitkeep
data/frozen/*
!data/frozen/.gitkeep

# ---- Reports are generated, but committed on purpose ----
# This is a learning repo: the markdown summaries and charts are the visible
# record of what the agent did, so they belong in git. `make clean` wipes them
# and the next run regenerates them.

# ---- Byte-compiled / optimized / DLL files ----
__pycache__/
*.py[cod]
*$py.class
*.so

# ---- Distribution / packaging ----
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# ---- Unit test / coverage reports ----
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
cover/

# ---- Environments ----
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# ---- Type checkers / linters ----
.mypy_cache/
.dmypy.json
dmypy.json
.pyre/
.pytype/
.ruff_cache/

# ---- Jupyter / IPython ----
.ipynb_checkpoints
profile_default/
ipython_config.py

# ---- Editors & OS ----
.idea/
.vscode/
*.swp
*.swo
.DS_Store

# ---- Claude Code local overrides ----
.claude/settings.local.json

# Advisory file locks guarding the append-only artifacts (see locking.py)
*.lock

# ---- Per-pass run directories ----
# The textual record of each pass is committed: run.md, metadata.json and the
# step reports are small and genuinely differ between passes. The charts are
# not: the data is frozen and the seed is fixed, so every pass regenerates
# byte-identical PNGs, and reports/ already holds the latest copy of each.
runs/**/*.png
runs/**/submission.csv
# In-memory hand-off from `make bakeoff` to `make bakeoff-decide`: a cache,
# not evidence -- every number in it is also in the ledger.
runs/**/bakeoff.pickle

# Redaction term list: naming what is hidden would publish it
scripts/redact_terms.txt

# Session exports stay out of the repo. Transcripts are not published at all
# (decided 2026-10-10); this rule is the backstop that keeps a stray export
# from being committed by accident.
/20??-??-??-*.txt
